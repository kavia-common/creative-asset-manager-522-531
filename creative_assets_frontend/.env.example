# Meta Ads Manager integration (required for real push)
# These variables are read on the frontend for demonstration only.
# In production, do NOT expose tokens to the browser; route via your backend.
REACT_APP_META_APP_ID=your_meta_app_id_here
REACT_APP_META_ACCESS_TOKEN=your_long_lived_user_or_system_token_here
REACT_APP_META_AD_ACCOUNT_ID=act_1234567890

# Optional: If you add a backend, point the frontend to it
# REACT_APP_API_BASE=https://your-backend.example.com
